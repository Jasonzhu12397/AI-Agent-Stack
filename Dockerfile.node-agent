FROM alpine:3.21 AS clusterctl
ARG CLUSTERCTL_VERSION
ARG CLUSTERCTL_SHA256_AMD64
ARG CLUSTERCTL_SHA256_ARM64
ARG KUBECTL_VERSION
ARG KUBECTL_SHA256_AMD64
ARG KUBECTL_SHA256_ARM64
ARG TARGETARCH
RUN test -n "$CLUSTERCTL_VERSION" && test -n "$KUBECTL_VERSION" && \
    case "$TARGETARCH" in \
      amd64) ASSET_ARCH=amd64; CLUSTERCTL_CHECKSUM="$CLUSTERCTL_SHA256_AMD64"; KUBECTL_CHECKSUM="$KUBECTL_SHA256_AMD64" ;; \
      arm64) ASSET_ARCH=arm64; CLUSTERCTL_CHECKSUM="$CLUSTERCTL_SHA256_ARM64"; KUBECTL_CHECKSUM="$KUBECTL_SHA256_ARM64" ;; \
      *) echo "Unsupported target architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac && \
    test -n "$CLUSTERCTL_CHECKSUM" && test -n "$KUBECTL_CHECKSUM" && \
    wget -q -O /tmp/clusterctl "https://github.com/kubernetes-sigs/cluster-api/releases/download/${CLUSTERCTL_VERSION}/clusterctl-linux-${ASSET_ARCH}" && \
    echo "${CLUSTERCTL_CHECKSUM}  /tmp/clusterctl" | sha256sum -c - && \
    install -m 0755 /tmp/clusterctl /usr/local/bin/clusterctl && \
    wget -q -O /tmp/kubectl "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${ASSET_ARCH}/kubectl" && \
    echo "${KUBECTL_CHECKSUM}  /tmp/kubectl" | sha256sum -c - && \
    install -m 0755 /tmp/kubectl /usr/local/bin/kubectl

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 HOME=/tmp PYTHONPATH=/workspace
WORKDIR /workspace
RUN pip install --no-cache-dir "PyYAML>=6.0,<7.0"
COPY apps/node_agent ./apps/node_agent
COPY --from=clusterctl /usr/local/bin/clusterctl /usr/local/bin/clusterctl
COPY --from=clusterctl /usr/local/bin/kubectl /usr/local/bin/kubectl
USER 10001:10001
CMD ["python", "-m", "apps.node_agent.agent", "--poll-seconds", "5"]
