FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PYTHONPATH=/workspace HOME=/tmp
WORKDIR /workspace
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/*
ARG CLUSTERCTL_VERSION
ARG CLUSTERCTL_SHA256_AMD64
ARG KUBECTL_VERSION
ARG KUBECTL_SHA256_AMD64
RUN test -n "$CLUSTERCTL_VERSION" && test -n "$KUBECTL_VERSION" && \
    curl -fsSLo /usr/local/bin/clusterctl "https://github.com/kubernetes-sigs/cluster-api/releases/download/${CLUSTERCTL_VERSION}/clusterctl-linux-amd64" && \
    echo "${CLUSTERCTL_SHA256_AMD64}  /usr/local/bin/clusterctl" | sha256sum -c - && \
    curl -fsSLo /usr/local/bin/kubectl "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/amd64/kubectl" && \
    echo "${KUBECTL_SHA256_AMD64}  /usr/local/bin/kubectl" | sha256sum -c - && chmod 0755 /usr/local/bin/clusterctl /usr/local/bin/kubectl
COPY pyproject.toml README.md ./
COPY packages/agent_contracts ./packages/agent_contracts
COPY packages/agent_transport ./packages/agent_transport
COPY apps/eph_agent ./apps/eph_agent
RUN pip install --no-cache-dir "httpx>=0.27,<1.0" "pydantic>=2.8,<3.0"
USER 10001:10001
ENTRYPOINT ["python", "-m", "apps.eph_agent.main"]
