APP_ENV=production
DEBUG=false
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql://agent:replace-me@postgres.example.net:5432/agent_stack?sslmode=require
REDIS_URL=rediss://:replace-me@redis.example.net:6379/0
QDRANT_URL=https://qdrant.example.net
ALLOWED_HOSTS=ai-agent.example.com
CSRF_TRUSTED_ORIGINS=https://ai-agent.example.com
CORS_ALLOWED_ORIGINS=https://ai-agent.example.com
LOCAL_MODEL_ALLOWED_HOSTS=
MODEL_PROVIDER_ALLOWED_HOSTS=
PLUGIN_HTTP_ALLOWED_HOSTS=
PLUGIN_CREDENTIAL_RESOLVER=
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
WORKER_POLL_SECONDS=2
AGENT_MTLS_TRUSTED_PROXY_IP=
AGENT_MTLS_REQUIRED=false
AGENT_MTLS_TRUSTED_PROXY_CIDRS=
AGENT_MTLS_NETWORK_SUBNET=172.30.250.0/24
AGENT_MTLS_INGRESS_IP=172.30.250.2
AGENT_MTLS_BIND_ADDRESS=127.0.0.1
AGENT_MTLS_PORT=8443
AGENT_MTLS_SERVER_PEM=/etc/ai-agent/agent-ingress.pem
AGENT_MTLS_CLIENT_CA_PEM=/etc/ai-agent/agent-client-ca.pem
COMPOSE_PROFILES=

BMC_CREDENTIAL_RESOLVER=
BMC_VAULT_ADDR=
BMC_VAULT_TOKEN=
BMC_VAULT_TOKEN_RESOLVER=
BMC_VAULT_JWT_PATH=
BMC_VAULT_JWT_ROLE=
BMC_VAULT_JWT_AUTH_MOUNT=jwt
BMC_VAULT_JWT_TENANT_CLAIM=tenant_id
BMC_VAULT_JWT_PROJECT_CLAIM=project_id
BMC_VAULT_NAMESPACE=
BMC_VAULT_CA_BUNDLE=
BMC_VAULT_TIMEOUT_SECONDS=5

EPH_PKI_MOUNT=pki
EPH_PKI_ROLE=agent-nodes
EPH_PKI_TTL=24h
EPH_PKI_TRUSTED_CA_BUNDLE=
EPH_SEED_ENCRYPTION_KEY=
