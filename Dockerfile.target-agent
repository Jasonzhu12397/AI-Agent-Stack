FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PYTHONPATH=/workspace/apps:/workspace HOME=/tmp
WORKDIR /workspace
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/*
ARG KUBECTL_VERSION
ARG KUBECTL_SHA256_AMD64
ARG TARGETARCH
RUN test -n "$KUBECTL_VERSION" && \
    case "$TARGETARCH" in amd64) ASSET_ARCH=amd64; CHECKSUM="$KUBECTL_SHA256_AMD64" ;; *) echo "Unsupported TARGETARCH: $TARGETARCH" >&2; exit 1 ;; esac && \
    curl -fsSLo /usr/local/bin/kubectl "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${ASSET_ARCH}/kubectl" && \
    echo "${CHECKSUM}  /usr/local/bin/kubectl" | sha256sum -c - && chmod 0755 /usr/local/bin/kubectl
COPY pyproject.toml README.md ./
COPY packages/__init__.py ./packages/__init__.py
COPY packages/agent_contracts ./packages/agent_contracts
COPY packages/agent_transport ./packages/agent_transport
COPY apps/agent_contracts ./apps/agent_contracts
COPY apps/target_agent ./apps/target_agent
RUN pip install --no-cache-dir "httpx>=0.27,<1.0" "pydantic>=2.8,<3.0" "psycopg[binary]>=3.2,<4.0"
USER 10001:10001
ENTRYPOINT ["python", "-m", "apps.target_agent.main"]
