APP_ENV=development
APP_NAME=AI Agent Stack
SECRET_KEY=local-only-change-before-production
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,api
DATABASE_URL=postgresql://agent:agent_dev_password@postgres:5432/agent_stack
REDIS_URL=redis://redis:6379/0
CACHE_ENABLED=false
CACHE_KEY_PREFIX=aiagentstack
CACHE_DEFAULT_TIMEOUT=300
CACHE_LOCK_TIMEOUT=60
CACHE_HEALTH_TIMEOUT=10
LOG_LEVEL=INFO
WORKER_POLL_SECONDS=2
MODEL_PROVIDER_ALLOWED_HOSTS=
PLUGIN_HTTP_ALLOWED_HOSTS=
PLUGIN_CREDENTIAL_RESOLVER=

AGENT_CONTROL_URL=http://api:8000
EPH_AGENT_NODE_ID=
EPH_AGENT_TOKEN=
TARGET_AGENT_NODE_ID=
TARGET_AGENT_TOKEN=

# Hourly etcd backup scheduler and watchdog (compose services etcd-backup-scheduler
# and etcd-backup-watchdog). The webhook receives one POST per watchdog run that
# found a cluster without a usable recent backup; leave it empty to only audit.
ETCD_BACKUP_INTERVAL_SECONDS=3600
ETCD_BACKUP_WATCHDOG_INTERVAL_SECONDS=3600
ETCD_BACKUP_ALERT_WEBHOOK=
ETCD_BACKUP_ALERT_TIMEOUT_SECONDS=10
