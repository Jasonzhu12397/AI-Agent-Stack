[Unit]
Description=Enroll EPH Agent into the temporary Kubernetes cluster
Wants=network-online.target cloud-init.target mnt-eph\\x2dbootstrap.mount
After=cloud-init.target network-online.target mnt-eph\\x2dbootstrap.mount eph-kubeadm-init.service
Requires=eph-kubeadm-init.service mnt-eph\\x2dbootstrap.mount
StartLimitIntervalSec=15min
StartLimitBurst=10

[Service]
Type=oneshot
ExecStartPre=/usr/bin/cloud-init status --wait
ExecStart=/usr/bin/python3 /usr/local/lib/eph-bootstrap.py
RemainAfterExit=yes
Restart=on-failure
RestartSec=30s
TimeoutStartSec=40min

[Install]
WantedBy=multi-user.target
