[Unit]
Description=Enroll EPH Agent into the temporary Kubernetes cluster
Wants=network-online.target
After=cloud-config.service network-online.target eph-kubeadm-init.service
Requires=eph-kubeadm-init.service
StartLimitIntervalSec=15min
StartLimitBurst=10

[Service]
Type=oneshot
ExecStartPre=/usr/bin/cloud-init status --wait
ExecStart=/usr/bin/python3 /usr/local/lib/eph-bootstrap.py
RemainAfterExit=yes
Restart=on-failure
RestartSec=30s
TimeoutStartSec=40min

[Install]
WantedBy=multi-user.target
