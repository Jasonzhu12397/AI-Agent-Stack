[Unit]
Description=Initialize the temporary EPH Kubernetes cluster with kubeadm
Wants=network-online.target containerd.service kubelet.service
After=network-online.target containerd.service kubelet.service var-lib-containerd.mount var-lib-kubelet.mount var-lib-etcd.mount
Requires=containerd.service var-lib-containerd.mount var-lib-kubelet.mount var-lib-etcd.mount

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/eph-node
ExecStart=/usr/local/sbin/eph-kubeadm-init.sh
RemainAfterExit=yes
TimeoutStartSec=20min

[Install]
WantedBy=multi-user.target
