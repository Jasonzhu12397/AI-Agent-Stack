[Unit]
Description=Initialize the temporary EPH Kubernetes cluster with kubeadm
StartLimitIntervalSec=30min
StartLimitBurst=5
Wants=network-online.target containerd.service
After=network-online.target containerd.service var-lib-containerd.mount var-lib-kubelet.mount var-lib-etcd.mount
After=cloud-config.service
Requires=containerd.service var-lib-containerd.mount var-lib-kubelet.mount var-lib-etcd.mount

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/eph-node
ExecStart=/usr/bin/bash /usr/local/sbin/eph-kubeadm-init.sh
RemainAfterExit=yes
Restart=on-failure
RestartSec=30s
TimeoutStartSec=30min

[Install]
WantedBy=multi-user.target
