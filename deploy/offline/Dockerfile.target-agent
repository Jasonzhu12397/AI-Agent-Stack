FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PYTHONPATH=/workspace/apps:/workspace HOME=/tmp
WORKDIR /workspace
COPY deploy/offline/assets/wheels /opt/offline-wheels
COPY deploy/offline/assets/bin/kubectl /usr/local/bin/kubectl
RUN chmod 0755 /usr/local/bin/kubectl && \
    pip install --no-index --find-links=/opt/offline-wheels "httpx>=0.27,<1.0" "pydantic>=2.8,<3.0" "psycopg[binary]>=3.2,<4.0" "PyYAML>=6.0,<7.0"
COPY pyproject.toml README.md ./
COPY packages/__init__.py ./packages/__init__.py
COPY packages/agent_contracts ./packages/agent_contracts
COPY packages/agent_transport ./packages/agent_transport
COPY apps/__init__.py ./apps/__init__.py
COPY apps/agent_contracts ./apps/agent_contracts
COPY apps/target_agent ./apps/target_agent
COPY apps/dev_agent ./apps/dev_agent
USER 10001:10001
ENTRYPOINT ["python", "-m", "apps.target_agent.main"]
