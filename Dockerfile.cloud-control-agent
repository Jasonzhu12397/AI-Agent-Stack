FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 HOME=/tmp
WORKDIR /app
RUN pip install --no-cache-dir "psycopg[binary]>=3.2,<4.0"
COPY apps/cloud_control_agent ./apps/cloud_control_agent
USER 10001:10001
ENTRYPOINT ["python", "-m", "apps.cloud_control_agent.main"]
